switch(global.flarpernarpe){
	case "wilsons":
		if(instance_exists(mooover)){
			with (mooover) {
				setIsAttacking(true);
			}
		}
	break;
	case "idoxpeople":
		if(instance_exists(the_other_One)){
			with (the_other_One) {
				setIsAttacking(true);
			}
		}
	break;
	case "jaw gym":
		if(instance_exists(jaw_gym)){
			with (jaw_gym) {
				setIsAttacking(true);
			}
		}
		break;
	case "eyeeyeeyeeye":
		if(instance_exists(the_other_the_other_One_1)){
			with (the_other_the_other_One_1) {
				setIsAttacking(true);
			}
		}
		break;
	default:
	break;
}


